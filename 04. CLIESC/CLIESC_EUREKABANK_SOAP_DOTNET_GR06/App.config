<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>

    <!-- Endpoint del servicio SOAP — cambiar IP/puerto si es necesario -->
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="EurekaBinding" sendTimeout="00:02:00" maxReceivedMessageSize="10485760">
                    <readerQuotas maxStringContentLength="1048576" maxArrayLength="1048576" />
                </binding>
                <binding name="BasicHttpBinding_IService1" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8083/Service1.svc" binding="basicHttpBinding"
                bindingConfiguration="EurekaBinding" contract="EurekaServiceRef.IService1"
                name="BasicHttpBinding_IService1" />
            <endpoint address="http://26.61.187.252:8083/Service1.svc" binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IService1" contract="ServiceReference1.IService1"
                name="BasicHttpBinding_IService11" />
        </client>
    </system.serviceModel>
</configuration>